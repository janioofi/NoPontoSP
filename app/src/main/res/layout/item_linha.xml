<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/list_card"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/textLetreiro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="23sp"
        android:textStyle="bold"
        tools:text="8000-10 — Term. Lapa / Term. Pinheiros" />

    <TextView
        android:id="@+id/textItinerario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        tools:text="Terminal Principal → Terminal Secundário" />

    <TextView
        android:id="@+id/textSentido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        tools:text="Sentido: Terminal Principal → Terminal Secundário" />

</LinearLayout>
