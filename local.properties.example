# Copie este arquivo para "local.properties" (na raiz do projeto, ao lado de settings.gradle)
# e informe o caminho do SDK Android. O local.properties NUNCA deve ser commitado
# (o template de .gitignore do Android Studio já ignora esse arquivo por padrão).

# Caminho do SDK do Android (o Android Studio preenche isso automaticamente)
# sdk.dir=/caminho/para/o/Android/Sdk

# Configure o token de desenvolvedor Olho Vivo pelo menu de configurações do app.
